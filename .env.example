# cam2mcp Configuration
# Copy this file to .env and customize as needed.

# ---------------------------------------------------------------------------
# cam2ip process
# ---------------------------------------------------------------------------

# Start the bundled cam2ip. Set to "false" to point the MCP server at an
# external instance instead (see CAM2IP_BASE_URL).
CAM2IP_ENABLED=true

# Every flag cam2ip accepts is also readable as a CAM2IP_* variable -- it reads
# these itself, so anything it supports works here whether or not this file
# lists it. Run `docker run --rm <image> --help` for the full set.
CAM2IP_INDEX=0
CAM2IP_WIDTH=640
CAM2IP_HEIGHT=480
CAM2IP_QUALITY=75
CAM2IP_DELAY=10

# Where cam2ip listens. If you narrow this to one interface rather than every
# one, CAM2IP_BASE_URL below has to name that same address -- cam2ip only
# listens on what it bound to, so a mismatch leaves the MCP server unable to
# reach it. Startup fails with both values printed if they disagree.
CAM2IP_BIND_ADDR=0.0.0.0:56000

# The port docker-compose publishes for cam2ip. Keep it equal to the port in
# CAM2IP_BIND_ADDR above: compose cannot pick the port out of a bind address, so
# this is the one pairing it cannot keep in step for you.
CAM2IP_PORT=56000

# Open the camera only while something is subscribed, so the indicator light is
# off and the device is free while the server is idle.
CAM2IP_LAZY=true

# Draw the capture time onto each frame, so how fresh an image is can be read
# off the picture itself. Format is Go's reference layout; set to false to turn
# the stamp off.
CAM2IP_TIMESTAMP=true
CAM2IP_TIME_FORMAT=2006-01-02 15:04:05

# Pick a camera by name instead of index (substring match, overrides INDEX).
# CAM2IP_DEVICE=Logitech

# Optional image processing.
# CAM2IP_ROTATE=0
# CAM2IP_FLIP=horizontal

# Optional basic auth on the cam2ip HTTP endpoints.
# CAM2IP_HTPASSWD_FILE=/path/to/htpasswd

# ---------------------------------------------------------------------------
# MCP server
# ---------------------------------------------------------------------------

# Where to reach cam2ip. Needs changing when CAM2IP_ENABLED=false, when the bind
# port differs, or when CAM2IP_BIND_ADDR names a specific interface -- see the
# note on it above.
CAM2IP_BASE_URL=http://127.0.0.1:56000
CAM2IP_HTTP_TIMEOUT_S=5.0

# MCP transport:
#   stdio           - over stdin/stdout (default; Claude Desktop, Cline, ...)
#   sse             - Server-Sent Events (legacy HTTP transport)
#   streamable-http - current MCP spec HTTP transport
MCP_MODE=stdio
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3000

# Frame freshness. See "How frames stay fresh" in the README before changing
# these -- the defaults are what keep stale frames from coming back.
#
# Refuse to serve a frame that arrived longer ago than this; wait for a new one.
MCP_FRAME_MAX_AGE_S=1.0
# Give up (with an error) if no fresh frame arrives within this long.
MCP_GRAB_TIMEOUT_S=15.0
# Frames to discard after connecting to the stream. The number actually dropped
# is max(MCP_WARMUP_FRAMES, MCP_WARMUP_S x fps), and it has to exceed the
# driver's queue depth or the first frame after an idle period is stale. V4L2
# drivers usually give the four buffers korandiz/v4l asks for, but may grant
# more, so this pair is what covers that.
MCP_WARMUP_FRAMES=5
# At 30fps this window is ~7.5 frames, so it is the term that binds; below about
# 20fps the count above takes over. Raise the count if you meet a driver with a
# queue deeper than the window covers at your frame rate.
MCP_WARMUP_S=0.25
# Hold the camera stream open this long after the last request. Higher means
# faster replies; lower means the camera is released sooner.
MCP_STREAM_IDLE_S=30.0

# Logging level for the MCP server (always written to stderr).
MCP_LOG_LEVEL=INFO

# Restrict which Host/Origin headers the HTTP transports accept. Leave both
# unset for mcp's defaults: a loopback allowlist when bound to 127.0.0.1, and no
# restriction when bound to a public interface.
#
# Setting either one replaces those defaults, and mcp then checks Host and Origin
# together -- there is no way to say "any host", so MCP_ALLOWED_HOSTS is required
# as soon as you restrict anything. Setting only MCP_ALLOWED_ORIGINS is refused
# at startup rather than silently rejecting every request.
#
# Hosts alone is fine and is the common case: clients that send no Origin header
# (which is every non-browser MCP client) pass, and any request carrying an
# Origin is refused. Add MCP_ALLOWED_ORIGINS to let specific browsers back in.
# MCP_ALLOWED_HOSTS=camera.example.com:*,127.0.0.1:*
# MCP_ALLOWED_ORIGINS=https://app.example.com
